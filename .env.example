# Resend API Key
# Get your API key from https://resend.com/api-keys
# Resend API Key
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Integration
# 1. Crea una integración en: https://www.notion.so/my-integrations
# 2. Copia el "Internal Integration Token"
NOTION_INTEGRATION_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion Database ID
# 1. Abre tu base de datos en Notion
# 2. Copia el ID de la URL: https://notion.so/xxxxx?v=yyyyy
#    El ID es la parte "xxxxx" (32 caracteres)
# 3. Comparte la base de datos con tu integración
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxre_your_api_key_here

