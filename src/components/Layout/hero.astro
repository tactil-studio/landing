---
import { t } from "~/shared/i18n/fn";
import { T } from "~/shared/i18n/types";
import Link from "~/shared/ui/link.astro";
import Titles from "./titles.astro";
const l = Astro.currentLocale;
---

<article
  class="flex flex-col w-full gap-10 mt-50 mx-auto max-w-7xl px-6 xl:px-10"
>
  <Titles />

  <div
    class="flex flex-col gap-6 mb-8"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="soft"
    data-delay="300"
  >
    <p
      class="max-w-md balanced text-muted-foreground text-lg leading-relaxed"
      set:html={t(l, "summary")}
    />
  </div>

  <div
    class="flex gap-6 items-center max-md:text-sm flex-wrap"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="elastic"
    data-delay="500"
  >
    <Link href="#contact" variant="primary" size="lg">
      {t(l, T.getInTouch)}
    </Link>
    <Link href="#portafolio" variant="underline">
      {t(l, T.see_examples)}
    </Link>
  </div>
</article>
