---
import { Image } from "astro:assets";
import type { ProjectMetadata } from "~/lib/projects";
import type { Locale } from "~/shared/i18n/types";

const l = (Astro.currentLocale ?? "en") as Locale;
interface Props {
  project: ProjectMetadata;
}

const { project } = Astro.props;
const { data, id: _slug } = project;
const { title, category, media } = data;
---

<div class="group w-full relative flex flex-col items-center gap-20 pb-20">
  <header
    class="grid lg:grid-cols-2 gap-4 max-w-7xl w-full items-center max-xl:px-6"
  >
    <div>
      <span class="first-letter:uppercase text-sm text-muted-foreground"
        >{category}</span
      >
      <h3 class="font-medium text-3xl leading-snug">
        {title}
      </h3>
    </div>

    <div class="flex flex-col gap-2">
      <p class="text-[0.8em] max-w-lg text-muted-foreground">
        {data.summary[l]}
      </p>
    </div>
  </header>
  <section>
    <ul>
      {
        media.map((src) => (
          <li class="">
            {/* src could be an image (webp) or video (mp4), filter them */}

            {typeof src === "string" ? (
              <video
                class="image-sizing"
                src={src}
                title={`Video for ${title}`}
                controls
                preload="metadata"
                width={800}
                height={550}
              />
            ) : (
              <Image
                class="image-sizing rounded-lg shadow-xl border-2 border-foreground/20 bg-neutral-200"
                src={src}
                priority={false}
                loading={"lazy"}
                fetchpriority="low"
                decoding="async"
                title={`Cover Image for ${title}`}
                alt={title}
                width={800}
                height={550}
              />
            )}
          </li>
        ))
      }
    </ul>
  </section>
</div>

<style>
  ul {
    width: 100dvw;
    display: flex;
    height: 40vh;
    gap: 1dvw;
    overflow-x: scroll;
    padding: 0 calc((100vw - 80rem) / 2);
    scroll-snap-type: x proximity;
    align-items: center; /* Optional: vertically align images if they have different heights */
    /* OCULTAR BARRA DE SCROLL */
    -ms-overflow-style: none; /* Para IE y Edge */
    scrollbar-width: none; /* Para Firefox */
  }

  /* Esconde la barra de scroll para WebKit (Chrome, Safari, Edge moderno) */
  ul::-webkit-scrollbar {
    display: none;
  }

  li {
    overflow: hidden;
    list-style-type: none;
    scroll-snap-align: center;
    flex-shrink: 0;
    width: auto;
    height: 100%;
  }

  /* Style for the image within the li */
  .image-sizing {
    /* background-color: var(--color-primary); */
    width: auto;
    height: 100%;
    object-fit: contain;
    transition: all 0.3s ease-in-out;
  }
  @media screen and (max-width: 720px) {
    ul {
      height: 30vh;
      padding: 0 20px;
    }
    li {
      scroll-snap-align: none;
    }
  }
</style>
