---
import LanguageSelector from "~/shared/language-selector.astro";
import ThemeToggle from "~/shared/ui/theme/theme-toggle";
const lang = Astro.currentLocale;
const locale = (["es", "ca", "it"].includes(lang ?? "") ? lang : "en") as
  | "en"
  | "es"
  | "ca"
  | "it";

const labels = {
  en: { work: "Work", pricing: "Pricing", faq: "FAQ" },
  es: { work: "Trabajos", pricing: "Precios", faq: "FAQ" },
  ca: { work: "Treballs", pricing: "Preus", faq: "FAQ" },
  it: { work: "Lavori", pricing: "Prezzi", faq: "FAQ" },
} as const;

const withLocale = (path: string) => {
  if (locale === "en") return path;
  return path === "/" ? `/${locale}` : `/${locale}${path}`;
};

const navigationItems = [
  { href: withLocale("/#work"), label: labels[locale].work },
  { href: withLocale("/#pricing"), label: labels[locale].pricing },
  { href: withLocale("/#faq"), label: labels[locale].faq },
];
---

<header
  class="z-40 fixed top-0 w-full items-center flex justify-between py-4 md:py-6 px-6 md:px-10 delayed-appearing"
>
  <div class="flex items-center gap-8">
    <a
      href={withLocale("/")}
      aria-label="Tactil home"
      class="font-black text-2xl px-2 rounded-full bg-background/40 backdrop-blur-lg"
    >
      tactil.
    </a>
    <nav
      class="hidden md:flex items-center gap-2 px-3 py-2 rounded-full bg-background/40 backdrop-blur-lg"
    >
      {
        navigationItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-foreground/80 hover:text-foreground transition-colors"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div
    class="flex gap-2 items-center px-1 rounded-full bg-background/40 backdrop-blur-lg py-1"
  >
    <ThemeToggle client:load />
    <LanguageSelector />
  </div>
</header>
