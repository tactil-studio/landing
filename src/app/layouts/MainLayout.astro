---
import "@polgubau/astro-reveal/styles";
import BaseHead from "~/components/BaseHead.astro";
import ThemeScript from "~/shared/ui/theme/theme-script.astro";
import Footer from "./footer/footer.astro";
import Navbar from "./navbar/Navbar.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<html
  lang={Astro.currentLocale || "en"}
  dir="ltr"
  class="w-screen overflow-x-hidden scroll-smooth"
>
  <head>
    <ThemeScript />
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
  </head>
  <body class="antialiased">
    <Navbar />
    <main
      class="flex min-h-screen w-full flex-col gap-20 max-md:gap-10 bg-primary"
    >
      <div class="bg-background rounded-b-[5vw] flex flex-col gap-20">
        <div class="items-center flex-col pb-[5vw] w-full">
          <slot />
        </div>
      </div>
      <Footer />
    </main>
    <script>
      import "@polgubau/astro-reveal";
    </script>
  </body>
</html>

<style is:global>
  @keyframes opacity-fade {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    20% {
      opacity: 0;
      filter: blur(10px);
      pointer-events: none;
      transform: translateY(0);
    }

    to {
      transform: translateY(-100vh);
    }
  }

  .delayed-appearing {
    opacity: 0;
    animation: fade-in 0.8s ease-in-out;
    animation-delay: 1s;
    animation-fill-mode: forwards;
  }
</style>
