---
import { useT } from "~/shared/i18n/fn";
import type { TranslationKey } from "~/shared/i18n/types";
import Link from "~/shared/ui/link.astro";

const t = useT(Astro.currentLocale);
const l = Astro.currentLocale;

type Pricing = {
  id: string;
  isPopular?: boolean;
  oldPrice?: number;
  price?: number;
  title: TranslationKey;
  description: TranslationKey;
  features: TranslationKey[];
  cta: TranslationKey;
};

const pricingPacks: Pricing[] = [
  {
    id: "business",
    oldPrice: 1499,
    price: 699,
    title: "pack_1_title",
    description: "pack_1_description",
    features: ["pack_1_feature_1","pack_1_feature_2","pack_1_feature_3","pack_1_feature_4","pack_1_feature_5"],
    cta: "pack_1_cta",
  },
  {
    id: "landing",
    isPopular: true,
    oldPrice: 799,
    price: 499,
    title: "pack_2_title",
    description: "pack_2_description",
    features: ["pack_2_feature_1","pack_2_feature_2","pack_2_feature_3","pack_2_feature_4","pack_2_feature_5"],
    cta: "pack_2_cta",
  },
  {
    id: "custom",
    title: "pack_3_title",
    description: "pack_3_description",
    features: ["pack_3_feature_1","pack_3_feature_2","pack_3_feature_3","pack_3_feature_4","pack_3_feature_5"],
    cta: "pack_3_cta",
  },
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t("prices"),
  itemListElement: pricingPacks
    .filter((p) => p.price)
    .map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Offer",
        name: t(p.title),
        description: t(p.description),
        price: String(p.price),
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: `${Astro.url.origin}${l && l !== "en" ? `/${l}` : ""}/#pricing`,
      },
    })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />

<section
  id="pricing"
  aria-labelledby="pricing-heading"
  class="flex flex-col gap-12 py-24 px-6 mx-auto max-w-7xl xl:px-10"
>
  <header
    class="flex flex-col gap-4 text-center"
    data-reveal="bottom"
    data-speed="normal"
    data-easing="soft"
  >
    <h2 id="pricing-heading" class="text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
      {t("prices")}
    </h2>
    <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto">
      {t("prices_subtitle")}
    </p>
  </header>
  <ul
    class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8 max-w-7xl mx-auto w-full"
    data-stagger="120"
  >
    {
      pricingPacks.map((pricing) => (
        <li
          data-reveal="bottom"
          data-easing="soft"
          class:list={[
            "grid relative bg-background border border-border rounded-2xl overflow-hidden p-8 hover:shadow-xl transition-all duration-300",
            {
              "grid-rows-[auto_1fr_auto]": pricing.oldPrice || pricing.price,
              "grid-rows-[1fr_auto]": !pricing.oldPrice && !pricing.price,
              "border-primary ring-2 ring-primary shadow-lg": pricing.isPopular,
              "bg-linear-to-br from-primary/5 to-secondary/5": pricing.id === "custom",
            },
          ]}
        >
          {pricing.isPopular && (
            <div
              aria-label={t("popular")}
              class="absolute top-0 right-0 bg-primary text-background text-xs font-bold px-4 py-2 rounded-bl-xl rounded-tr-2xl uppercase tracking-wide"
            >
              {t("popular")}
            </div>
          )}

          {(pricing.oldPrice || pricing.price) && (
            <div class="flex flex-col pb-6 border-b border-border">
              {pricing.oldPrice && (
                <span class="text-sm text-muted-foreground">
                  <span class="sr-only">Original price: </span>
                  <span class="line-through" aria-hidden="true">{pricing.oldPrice}€</span>
                </span>
              )}
              {pricing.price && (
                <div class="flex items-baseline gap-1">
                  <span class="text-4xl font-bold">{pricing.price}€</span>
                  <span class="text-sm text-muted-foreground">{t("per_project")}</span>
                </div>
              )}
            </div>
          )}
          <div class="flex flex-col gap-6 py-6">
            <div>
              <h3 class="text-2xl font-bold mb-2">{t(pricing.title)}</h3>
              <p class="text-muted-foreground text-sm leading-relaxed">
                {t(pricing.description)}
              </p>
            </div>
            <ul class="flex flex-col gap-3" role="list">
              {pricing.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm">
                  <svg
                    class="w-5 h-5 text-primary shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                  <span class="leading-relaxed">{t(feature)}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="flex gap-2 items-center pt-4">
            <Link
              href="#contact"
              variant="primary"
              class="w-full text-center"
              aria-label={`${t(pricing.cta)} — ${t(pricing.title)}`}
            >
              {t(pricing.cta)}
            </Link>
          </div>
        </li>
      ))
    }
  </ul>
</section>
