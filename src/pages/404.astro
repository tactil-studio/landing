---
export const prerender = true;
import MainLayout from "~/app/layouts/MainLayout.astro";
import { getLangFromUrl, useT } from "~/shared/i18n/fn";
import Button from "~/shared/ui/button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useT(lang);
const prefix = lang === "en" ? "" : `/${lang}`;

const popularLinks = [
  { label: t("nav_home"), href: `${prefix}/` },
  { label: t("nav_projects"), href: `${prefix}/projects` },
  { label: t("nav_contact"), href: `${prefix}/contact` },
];
---

<MainLayout
  title={`404 - ${t("not_found_title")}`}
  description={t("not_found_description")}
>
  <div class="min-h-screen flex items-center justify-center px-6 py-32">
    <div class="max-w-2xl mx-auto text-center space-y-8">
      <!-- Número 404 grande -->
      <div
        class="relative"
        data-reveal="scale"
        data-speed="fast"
        data-easing="bounce"
      >
        <h1
          class="text-[12rem] md:text-[16rem] font-bold text-primary/10 leading-none select-none"
        >
          404
        </h1>
        <div
          class="absolute inset-0 flex items-center justify-center"
          data-reveal="scale"
          data-speed="normal"
          data-easing="elastic"
          data-delay="200"
        >
          <svg
            class="size-32 md:size-40 text-primary"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
            ></path>
          </svg>
        </div>
      </div>

      <!-- Mensaje -->
      <div class="space-y-4" data-stagger="100">
        <h2
          class="text-3xl md:text-4xl font-bold text-foreground"
          data-reveal="bottom"
          data-speed="normal"
          data-easing="smooth"
        >
          {t("not_found_title")}
        </h2>
        <p
          class="text-lg text-muted-foreground max-w-md mx-auto"
          data-reveal="bottom"
          data-speed="normal"
          data-easing="soft"
        >
          {t("not_found_description")}
        </p>
      </div>

      <!-- Links populares -->
      <div
        class="flex flex-wrap gap-3 justify-center"
        data-stagger="80"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="smooth"
      >
        {
          popularLinks.map((link) => (
            <a
              href={link.href}
              class="px-6 py-3 rounded-lg bg-accent hover:bg-accent/80 text-foreground font-medium transition-colors"
              data-reveal="scale"
              data-speed="fast"
              data-easing="bounce"
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- CTA principal -->
      <div
        class="pt-8"
        data-reveal="scale"
        data-speed="fast"
        data-easing="elastic"
        data-delay="400"
      >
        <a href={`${prefix}/`}>
          <Button withArrow>{t("not_found_back")}</Button>
        </a>
      </div>

      <!-- Mensaje adicional -->
      <p
        class="text-sm text-muted-foreground pt-8"
        data-reveal="bottom"
        data-speed="normal"
        data-easing="soft"
        data-delay="500"
      >
        {t("not_found_contact_prompt")}{" "}
        <a href={`${prefix}/contact`} class="text-primary hover:underline">
          {t("not_found_contact_link")}
        </a>
      </p>
    </div>
  </div>
</MainLayout>
