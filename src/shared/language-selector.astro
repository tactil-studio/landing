---
import NativeSelect from "~/components/ui/native-select/NativeSelect.astro";
import NativeSelectOption from "~/components/ui/native-select/native-select-option.astro";
import { localeList } from "./i18n/locales";

const lang = Astro.currentLocale;

// Obtener la ruta actual sin el prefijo de idioma
const currentPath = Astro.url.pathname;
const pathWithoutLocale = currentPath.replace(/^\/(es|ca|it)(\/|$)/, "/");

// Generar URLs para cada idioma
const getLocalizedUrl = (localeCode: string) => {
  if (localeCode === "en") {
    return pathWithoutLocale === "/" ? "/" : pathWithoutLocale;
  }
  return `/${localeCode}${pathWithoutLocale === "/" ? "" : pathWithoutLocale}`;
};
---

<NativeSelect
  size="sm"
  id="language-selector"
  class="appearance-none bg-background text-foreground border border-border rounded-md px-3 py-1 pr-8 text-sm cursor-pointer hover:border-primary/40 transition-colors focus:outline-none focus:ring-2 focus:ring-primary/20 [&>option]:bg-background [&>option]:text-foreground dark:[&>option]:bg-gray-900 dark:[&>option]:text-white"
  aria-label="Select language"
  data-current-locale={lang}
>
  {
    localeList.map((locale) => (
      <NativeSelectOption
        value={getLocalizedUrl(locale)}
        selected={lang === locale}
        data-locale={locale}
      >
        {locale.toUpperCase()}
      </NativeSelectOption>
    ))
  }
</NativeSelect>
<script>
  function initLanguageSelector() {
    const el = document.getElementById(
      "language-selector",
    ) as HTMLSelectElement | null;
    if (!el) return;

    // Clone to strip any previous listener (safe across View Transitions)
    const fresh = el.cloneNode(true) as HTMLSelectElement;
    el.parentNode?.replaceChild(fresh, el);

    fresh.addEventListener("change", (e) => {
      const target = e.target as HTMLSelectElement;
      const selectedOption = target.options[target.selectedIndex];
      const locale = selectedOption.dataset.locale;
      const newUrl = target.value;

      if (locale) {
        const maxAge = 60 * 60 * 24 * 365;
        document.cookie = `preferred-locale=${locale}; path=/; max-age=${maxAge}; SameSite=Lax`;
      }

      window.location.href = newUrl;
    });
  }

  initLanguageSelector();
  document.addEventListener("astro:page-load", initLanguageSelector);
</script>
